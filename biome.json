{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!out",
      "!build",
      "!node_modules",
      "!next-env.d.ts",
      "!tsconfig.tsbuildinfo",
      "!package-lock.json",
      "!public",
      "!drizzle",
      "!components/ui"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnreachable": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noDeprecatedImports": "error",
        "noDocumentImportInPage": "error",
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noHeadImportInDocument": "error",
        "noReactForwardRef": "error",
        "noReactStringRefs": "error",
        "noTsIgnore": "error"
      },
      "style": {
        "noHeadElement": "error",
        "noProcessEnv": "error",
        "useImportType": "error"
      },
      "performance": {
        "noImgElement": "error",
        "noSyncScripts": "error"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe"
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "tailwind": {
    "attributes": ["class", "className"],
    "mergeFunctions": ["cn", "clsx", "cx", "tw"],
    "variantFunctions": ["cva"]
  },
  "overrides": [
    {
      "includes": [
        "env.ts",
        "drizzle.config.ts",
        "next.config.ts",
        "lib/db/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["app/**", "components/**", "hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/env"],
                    "message": "env vars are read inside lib/ server modules — never in presentation code."
                  },
                  {
                    "group": ["@/lib/db", "@/lib/db/**", "!@/lib/db/queries"],
                    "message": "No direct DB access in presentation — only lib/db/queries is public."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/app/**/{page,layout,loading,error,not-found,template,default}.{ts,tsx}",
        "**/app/**/route.{ts,tsx}",
        "**/app/**/opengraph-image.{ts,tsx}",
        "**/app/**/icon.{ts,tsx}",
        "**/app/**/sitemap.{ts,tsx}",
        "**/app/**/manifest.{ts,tsx}",
        "**/pages/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    }
  ]
}
