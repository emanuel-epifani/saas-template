# DATABASE_URL — local: dockerized Postgres (`npm run db:start`).
# Prod: replace with the pooled URL from your provider (Neon/Supabase).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Better Auth — generate a secret: `openssl rand -base64 32` or `npx @better-auth/cli secret`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend — optional in dev: without it, auth emails are printed to the server console.
# In dev you can send from "Onboarding <onboarding@resend.dev>" without a verified domain.
RESEND_API_KEY=
EMAIL_FROM="SaaS Template <onboarding@resend.dev>"
