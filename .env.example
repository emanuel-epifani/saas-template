# Database — local default is the dockerized Postgres (`npm run db:start`).
#
# In production replace with your provider's URLs (Neon, Supabase, ...):
#   DATABASE_URL          -> pooled endpoint   (Neon "-pooler" host / Supabase :6543)
#   DATABASE_URL_UNPOOLED -> direct endpoint   (Neon direct host / Supabase :5432)
# The pooling is server-side: the app code and driver never change.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/app
